<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15" styleClass="login-root"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.isayev.accounting.ui.controller.LoginController">

    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <Label text="1Accounting" styleClass="app-title">
        <font>
            <Font name="System Bold" size="28"/>
        </font>
    </Label>

    <Label text="Бухгалтерия и Отчётность" styleClass="app-subtitle">
        <font>
            <Font size="14"/>
        </font>
    </Label>

    <VBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Логин:"/>
        <TextField fx:id="usernameField" promptText="Введите логин" prefWidth="300"/>
    </VBox>

    <VBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Пароль:"/>
        <PasswordField fx:id="passwordField" promptText="Введите пароль" prefWidth="300"
                       onAction="#handleLogin"/>
    </VBox>

    <Button text="Войти в систему" onAction="#handleLogin" prefWidth="300" defaultButton="true"
            styleClass="primary-button"/>

    <Label fx:id="statusLabel" text="" styleClass="status-label"/>

    <Label text="© 2026 Isayev Team | Open Source" styleClass="footer-label">
        <font>
            <Font size="10"/>
        </font>
    </Label>
</VBox>
